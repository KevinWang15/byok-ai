{
  "name": "byok-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env backend/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && npm run build:client && npm run build:server && npm run build:lib",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/server/server.js",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run build && npm test",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@assistant-ui/react": "^0.15.32",
    "@headlessui/react": "^2.2.10"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.92",
    "@ai-sdk/google": "^4.0.108",
    "@ai-sdk/mcp": "^2.0.87",
    "@ai-sdk/openai": "^4.0.105",
    "@assistant-ui/react-markdown": "^0.14.24",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "ai": "^7.0.157",
    "quickjs-emscripten-core": "0.32.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.15.32",
    "@eslint/js": "^10.0.1",
    "@fastify/static": "^10.1.3",
    "@headlessui/react": "^2.2.10",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fastify": "^5.12.4",
    "globals": "^17.12.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
